# ==============================================================================
# Plantilla de Configuración (.env.example) para Voice Assistant
# ==============================================================================

# Rol del nodo: "nodo_c" (móvil lenovo), "taller" (nodo_a core 2 duo), "oficina"
NODE_ROLE=nodo_c

# Si este nodo es una laptop portátil que puede salir de la red local
IS_MOBILE=true

# Si la CPU carece de instrucciones AVX (True para Core 2 Duo)
IS_LOW_SPEC_CPU=false

# Endpoint de Ollama (127.0.0.1:11434 para local Docker, o IP remota para Core 2 Duo)
OLLAMA_URL=http://127.0.0.1:11434

# Modelo LLM de inferencia rápida
MODEL_NAME=qwen2.5:1.5b-instruct-q8_0

# Configuración de red para el intercomunicador
PEER_IP=192.168.1.100
INTERCOM_PORT=8765

# Lectura automática de notificaciones de mensajería (D-Bus)
READ_NOTIFICATIONS=false

# Voz TTS Piper:
# "es_MX-claude-high.onnx" (Español Mexicano)
# "es_ES-sharvard-medium.onnx" con PIPER_SPEAKER_ID=1 (Femenina neutra)
PIPER_MODEL_NAME=es_MX-claude-high.onnx
PIPER_SPEAKER_ID=

# Dispositivos de red (Smart TVs y Chromecast)
ROKU_SALA_IP=192.168.1.110
ROKU_CUARTO_IP=192.168.1.111
CHROMECAST_IP=192.168.1.112
LG_TV_IP=192.168.1.115
LG_TV_MAC=AA:BB:CC:DD:EE:FF
